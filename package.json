{
  "name": "tailtale",
  "private": true,
  "version": "1.12.0",
  "description": "书时 TailTale：游戏化阅读器 + 轻量工具箱",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "test:coverage": "tsc -p tsconfig.test.json && mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "smoke": "python3 scripts/smoke/smoke.py --serve dist"
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.1"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.12"
  }
}
